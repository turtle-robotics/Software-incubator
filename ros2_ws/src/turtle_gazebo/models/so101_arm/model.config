<?xml version="1.0"?>
<model>
  <name>so101_arm</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>TURTLE Robotics</name>
  </author>
  <description>
    SO-101 6-DOF robotic arm for Gazebo simulation.
    Joints: shoulder_pan, shoulder_lift, elbow_flex,
            wrist_flex, wrist_roll, gripper.
    Each joint is controllable via a dedicated ROS 2 topic.
  </description>
</model>
