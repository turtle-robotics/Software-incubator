<?xml version="1.0"?>
<!--
  SO-101 Arm — Gazebo SDF model for TURTLE Robotics SI
  =====================================================
  Joints and ROS 2 topics:
    shoulder_pan   /so101/shoulder_pan   (rad)
    shoulder_lift  /so101/shoulder_lift  (rad)
    elbow_flex     /so101/elbow_flex     (rad)
    wrist_flex     /so101/wrist_flex     (rad)
    wrist_roll     /so101/wrist_roll     (rad)
    finger_left    /so101/gripper        (rad, 0=open  0.6=closed)
    finger_right   mirrors finger_left via mimic (no separate topic)

  All joints publish state to /so101/joint_states.

  Table surface is at z=0.72 m. Arm base_pose places the base link
  ON the table: pose 1.0 0.0 0.72.
-->
<sdf version="1.10">
  <model name="so101_arm">

    <static>false</static>
    <!-- Base sits on the table (table top at z=0.72, base cylinder h=0.04 → centre at 0.72+0.02=0.74) -->
    <pose>1.0 0.0 0.72 0 0 0</pose>

    <!-- ============================================================
         BASE — bolted to table
         ============================================================ -->
    <link name="base">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia>
      </inertial>
      <collision name="base_col">
        <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="base_vis">
        <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="base_fixed" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>

    <!-- ============================================================
         LINK 1 — shoulder pan (Z)
         ============================================================ -->
    <link name="link1">
      <pose relative_to="shoulder_pan">0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0005</izz></inertia>
      </inertial>
      <collision name="l1_col">
        <geometry><cylinder><radius>0.035</radius><length>0.12</length></cylinder></geometry>
      </collision>
      <visual name="l1_vis">
        <geometry><cylinder><radius>0.035</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="shoulder_pan" type="revolute">
      <pose relative_to="base">0 0 0.02 0 0 0</pose>
      <parent>base</parent><child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.14</lower><upper>3.14</upper><effort>5</effort><velocity>2</velocity></limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 2 — shoulder lift (Y)
         ============================================================ -->
    <link name="link2">
      <pose relative_to="shoulder_lift">0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia><ixx>0.0008</ixx><iyy>0.0008</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="l2_col">
        <geometry><box><size>0.03 0.03 0.14</size></box></geometry>
      </collision>
      <visual name="l2_vis">
        <geometry><box><size>0.03 0.03 0.14</size></box></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="shoulder_lift" type="revolute">
      <pose relative_to="link1">0 0 0.06 0 0 0</pose>
      <parent>link1</parent><child>link2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>5</effort><velocity>2</velocity></limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 3 — elbow flex (Y)
         ============================================================ -->
    <link name="link3">
      <pose relative_to="elbow_flex">0 0 0.065 0 0 0</pose>
      <inertial>
        <mass>0.18</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="l3_col">
        <geometry><box><size>0.028 0.028 0.13</size></box></geometry>
      </collision>
      <visual name="l3_vis">
        <geometry><box><size>0.028 0.028 0.13</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="elbow_flex" type="revolute">
      <pose relative_to="link2">0 0 0.07 0 0 0</pose>
      <parent>link2</parent><child>link3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.70</lower><upper>2.70</upper><effort>5</effort><velocity>2</velocity></limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 4 — wrist flex (Y)
         ============================================================ -->
    <link name="link4">
      <pose relative_to="wrist_flex">0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0002</izz></inertia>
      </inertial>
      <collision name="l4_col">
        <geometry><box><size>0.025 0.025 0.10</size></box></geometry>
      </collision>
      <visual name="l4_vis">
        <geometry><box><size>0.025 0.025 0.10</size></box></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="wrist_flex" type="revolute">
      <pose relative_to="link3">0 0 0.065 0 0 0</pose>
      <parent>link3</parent><child>link4</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>3</effort><velocity>2</velocity></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 5 — wrist roll (Z)
         ============================================================ -->
    <link name="link5">
      <pose relative_to="wrist_roll">0 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="l5_col">
        <geometry><cylinder><radius>0.020</radius><length>0.08</length></cylinder></geometry>
      </collision>
      <visual name="l5_vis">
        <geometry><cylinder><radius>0.020</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="wrist_roll" type="revolute">
      <pose relative_to="link4">0 0 0.05 0 0 0</pose>
      <parent>link4</parent><child>link5</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.14</lower><upper>3.14</upper><effort>3</effort><velocity>2</velocity></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         GRIPPER PALM — rigid palm between link5 and fingers
         ============================================================ -->
    <link name="gripper_palm">
      <pose relative_to="gripper_palm_joint">0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.04</mass>
        <inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia>
      </inertial>
      <collision name="palm_col">
        <geometry><box><size>0.055 0.030 0.050</size></box></geometry>
      </collision>
      <visual name="palm_vis">
        <geometry><box><size>0.055 0.030 0.050</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="gripper_palm_joint" type="fixed">
      <pose relative_to="link5">0 0 0.04 0 0 0</pose>
      <parent>link5</parent>
      <child>gripper_palm</child>
    </joint>

    <!-- ============================================================
         LEFT FINGER — revolutes inward (positive angle closes)
         ============================================================ -->
    <link name="finger_left">
      <!-- offset to left side of palm, finger points down -->
      <pose relative_to="finger_left_joint">0 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000005</izz></inertia>
      </inertial>
      <collision name="fl_col">
        <geometry><box><size>0.010 0.010 0.050</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
          <contact>
            <ode><kp>5e5</kp><kd>1</kd><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
      <visual name="fl_vis">
        <geometry><box><size>0.010 0.010 0.050</size></box></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="finger_left_joint" type="revolute">
      <!-- pivot at the base of the left finger, offset +Y from palm centre -->
      <pose relative_to="gripper_palm">0.0 0.022 0.025 0 0 0</pose>
      <parent>gripper_palm</parent>
      <child>finger_left</child>
      <axis>
        <!-- rotates around X: positive angle swings finger inward (-Y) -->
        <xyz>1 0 0</xyz>
        <limit><lower>0</lower><upper>0.6</upper><effort>3</effort><velocity>1</velocity></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         RIGHT FINGER — mirrors left finger
         ============================================================ -->
    <link name="finger_right">
      <pose relative_to="finger_right_joint">0 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000005</izz></inertia>
      </inertial>
      <collision name="fr_col">
        <geometry><box><size>0.010 0.010 0.050</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
          <contact>
            <ode><kp>5e5</kp><kd>1</kd><min_depth>0.001</min_depth></ode>
          </contact>
        </surface>
      </collision>
      <visual name="fr_vis">
        <geometry><box><size>0.010 0.010 0.050</size></box></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="finger_right_joint" type="revolute">
      <pose relative_to="gripper_palm">0.0 -0.022 0.025 0 0 0</pose>
      <parent>gripper_palm</parent>
      <child>finger_right</child>
      <axis>
        <!-- negative X: positive angle swings this finger inward (+Y) -->
        <xyz>-1 0 0</xyz>
        <limit><lower>0</lower><upper>0.6</upper><effort>3</effort><velocity>1</velocity></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         WRIST CAMERA — fixed to link5, looks forward
         ============================================================ -->
    <link name="camera_link">
      <pose relative_to="link5">0 -0.03 0.02 0 0 -1.5708</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <visual name="cam_vis">
        <geometry><box><size>0.025 0.025 0.015</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="wrist_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>5.0</far></clip>
        </camera>
        <topic>/so101/camera/image_raw</topic>
      </sensor>
    </link>

    <joint name="camera_fixed" type="fixed">
      <parent>link5</parent>
      <child>camera_link</child>
    </joint>

    <!-- ============================================================
         GAZEBO PLUGINS
         ============================================================ -->

    <!-- Joint state publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/so101/joint_states</topic>
    </plugin>

    <!-- Arm joints (position controllers) -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pan</joint_name>
      <topic>/so101/shoulder_pan</topic>
      <p_gain>12</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_lift</joint_name>
      <topic>/so101/shoulder_lift</topic>
      <p_gain>12</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_flex</joint_name>
      <topic>/so101/elbow_flex</topic>
      <p_gain>12</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_flex</joint_name>
      <topic>/so101/wrist_flex</topic>
      <p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.3</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_roll</joint_name>
      <topic>/so101/wrist_roll</topic>
      <p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.3</d_gain>
    </plugin>

    <!-- Single gripper topic drives BOTH fingers symmetrically -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>finger_left_joint</joint_name>
      <topic>/so101/gripper</topic>
      <p_gain>5</p_gain><i_gain>0.02</i_gain><d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>finger_right_joint</joint_name>
      <topic>/so101/gripper</topic>
      <p_gain>5</p_gain><i_gain>0.02</i_gain><d_gain>0.1</d_gain>
    </plugin>

  </model>
</sdf>
