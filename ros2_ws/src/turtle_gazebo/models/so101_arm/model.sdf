<?xml version="1.0"?>
<!--
  SO-101 Arm — Gazebo SDF model for TURTLE Robotics SI
  =====================================================
  6 revolute joints (matching the real SO-101 hardware):
    shoulder_pan   → topic /so101/shoulder_pan   (rad)
    shoulder_lift  → topic /so101/shoulder_lift  (rad)
    elbow_flex     → topic /so101/elbow_flex     (rad)
    wrist_flex     → topic /so101/wrist_flex     (rad)
    wrist_roll     → topic /so101/wrist_roll     (rad)
    gripper        → topic /so101/gripper        (rad, 0=open 1.57=closed)

  All joints publish state to /so101/joint_states.
-->
<sdf version="1.10">
  <model name="so101_arm">

    <!-- Fixed to world — arm is table-mounted -->
    <static>false</static>
    <pose>1.0 0.0 0.0 0 0 0</pose>

    <!-- ============================================================
         BASE  (fixed to world via a static ground link)
         ============================================================ -->
    <link name="base">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia>
      </inertial>
      <collision name="base_col">
        <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="base_vis">
        <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- world → base (static joint keeps arm fixed in place) -->
    <joint name="base_fixed" type="fixed">
      <parent>world</parent>
      <child>base</child>
    </joint>

    <!-- ============================================================
         LINK 1 — shoulder pan (rotates around Z)
         ============================================================ -->
    <link name="link1">
      <pose relative_to="shoulder_pan_joint">0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0005</izz></inertia>
      </inertial>
      <collision name="l1_col">
        <geometry><cylinder><radius>0.035</radius><length>0.12</length></cylinder></geometry>
      </collision>
      <visual name="l1_vis">
        <geometry><cylinder><radius>0.035</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="shoulder_pan" type="revolute">
      <pose relative_to="base">0 0 0.02 0 0 0</pose>
      <parent>base</parent>
      <child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>5</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 2 — shoulder lift (pitches forward/back)
         ============================================================ -->
    <link name="link2">
      <pose relative_to="shoulder_lift_joint">0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>0.20</mass>
        <inertia><ixx>0.0008</ixx><iyy>0.0008</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="l2_col">
        <geometry><box><size>0.03 0.03 0.14</size></box></geometry>
      </collision>
      <visual name="l2_vis">
        <geometry><box><size>0.03 0.03 0.14</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="shoulder_lift" type="revolute">
      <pose relative_to="link1">0 0 0.06 0 0 0</pose>
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>5</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 3 — elbow flex
         ============================================================ -->
    <link name="link3">
      <pose relative_to="elbow_flex_joint">0 0 0.065 0 0 0</pose>
      <inertial>
        <mass>0.18</mass>
        <inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="l3_col">
        <geometry><box><size>0.028 0.028 0.13</size></box></geometry>
      </collision>
      <visual name="l3_vis">
        <geometry><box><size>0.028 0.028 0.13</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="elbow_flex" type="revolute">
      <pose relative_to="link2">0 0 0.07 0 0 0</pose>
      <parent>link2</parent>
      <child>link3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.70</lower>
          <upper>2.70</upper>
          <effort>5</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 4 — wrist flex
         ============================================================ -->
    <link name="link4">
      <pose relative_to="wrist_flex_joint">0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0002</izz></inertia>
      </inertial>
      <collision name="l4_col">
        <geometry><box><size>0.025 0.025 0.10</size></box></geometry>
      </collision>
      <visual name="l4_vis">
        <geometry><box><size>0.025 0.025 0.10</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wrist_flex" type="revolute">
      <pose relative_to="link3">0 0 0.065 0 0 0</pose>
      <parent>link3</parent>
      <child>link4</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>3</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 5 — wrist roll
         ============================================================ -->
    <link name="link5">
      <pose relative_to="wrist_roll_joint">0 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="l5_col">
        <geometry><cylinder><radius>0.020</radius><length>0.08</length></cylinder></geometry>
      </collision>
      <visual name="l5_vis">
        <geometry><cylinder><radius>0.020</radius><length>0.08</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wrist_roll" type="revolute">
      <pose relative_to="link4">0 0 0.05 0 0 0</pose>
      <parent>link4</parent>
      <child>link5</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>3</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         LINK 6 — gripper (parallel jaw, simplified as one revolute)
         ============================================================ -->
    <link name="gripper_link">
      <pose relative_to="gripper_joint">0 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="g_col">
        <geometry><box><size>0.06 0.015 0.06</size></box></geometry>
      </collision>
      <visual name="g_vis">
        <geometry><box><size>0.06 0.015 0.06</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.05 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="gripper" type="revolute">
      <pose relative_to="link5">0 0 0.04 0 0 0</pose>
      <parent>link5</parent>
      <child>gripper_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.57</upper>
          <effort>2</effort>
          <velocity>1</velocity>
        </limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <!-- ============================================================
         GAZEBO PLUGINS
         ============================================================ -->

    <!-- Publishes all joint positions to /so101/joint_states -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/so101/joint_states</topic>
    </plugin>

    <!-- Individual joint position controllers (one per joint) -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pan</joint_name>
      <topic>/so101/shoulder_pan</topic>
      <p_gain>10</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_lift</joint_name>
      <topic>/so101/shoulder_lift</topic>
      <p_gain>10</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_flex</joint_name>
      <topic>/so101/elbow_flex</topic>
      <p_gain>10</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_flex</joint_name>
      <topic>/so101/wrist_flex</topic>
      <p_gain>8</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_roll</joint_name>
      <topic>/so101/wrist_roll</topic>
      <p_gain>8</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.3</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gripper</joint_name>
      <topic>/so101/gripper</topic>
      <p_gain>5</p_gain>
      <i_gain>0.02</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>

  </model>
</sdf>
