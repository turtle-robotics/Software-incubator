<?xml version="1.0"?>
<!--
  arm_lab.sdf  —  SO-101 arm pickup lab world
  Includes: ground, lighting, table, red pickup cube
  The SO-101 arm model is spawned separately by the launch file.
-->
<sdf version="1.8">
  <world name="arm_lab">

    <!-- ── PHYSICS ──────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── REQUIRED PLUGINS ─────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ── LIGHTING ─────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- fill light so the arm doesn't go fully dark on its shadow side -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.1 -0.5</direction>
    </light>

    <!-- ── GROUND PLANE ──────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── TABLE ────────────────────────────────────────────────────── -->
    <!--
      Table surface is at z = 0.72 m (standard lab bench height).
      Arm base is at z = 0.72 m so its base sits on the table.
      Cube sits on the table surface directly in front of the gripper.
    -->
    <model name="table">
      <static>true</static>
      <pose>1.0 0.0 0.0 0 0 0</pose>
      <!-- tabletop -->
      <link name="top">
        <pose>0 0 0.70 0 0 0</pose>
        <inertial><mass>20</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="top_col">
          <geometry><box><size>0.80 0.60 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="top_vis">
          <geometry><box><size>0.80 0.60 0.04</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <!-- four legs -->
      <link name="leg_fl">
        <pose>-0.37 -0.27 0.36 0 0 0</pose>
        <inertial><mass>2</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.72</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.72</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_fr">
        <pose>-0.37 0.27 0.36 0 0 0</pose>
        <inertial><mass>2</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.72</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.72</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_bl">
        <pose>0.37 -0.27 0.36 0 0 0</pose>
        <inertial><mass>2</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.72</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.72</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_br">
        <pose>0.37 0.27 0.36 0 0 0</pose>
        <inertial><mass>2</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.72</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.72</size></box></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="j_fl" type="fixed"><parent>top</parent><child>leg_fl</child></joint>
      <joint name="j_fr" type="fixed"><parent>top</parent><child>leg_fr</child></joint>
      <joint name="j_bl" type="fixed"><parent>top</parent><child>leg_bl</child></joint>
      <joint name="j_br" type="fixed"><parent>top</parent><child>leg_br</child></joint>
    </model>

    <!-- ── RED PICKUP CUBE ───────────────────────────────────────────── -->
    <!--
      Cube is 4 cm per side. Placed on the table surface (z = 0.72 + 0.04/2 = 0.74),
      0.20 m in front of the arm base (which is at world x=1.0, y=0).
      So cube at world x = 1.0, y = -0.20, z = 0.74.
      High friction surface so the gripper can lift it.
    -->
    <model name="pickup_cube">
      <pose>1.0 -0.20 0.74 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0000133</ixx><iyy>0.0000133</iyy><izz>0.0000133</izz>
          </inertia>
        </inertial>
        <collision name="cube_col">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>1</kd>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="cube_vis">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
